{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": { "@/*": ["./resources/js/*"] },
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*"]
}
