# ALMESBAH production env — انسخه إلى .env وعدّل القيم
APP_NAME=ALMESBAH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_URL=https://almesbah-eg.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=error

# --- من cPanel → MySQL Databases ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CPANELUSER_almesbah
DB_USERNAME=CPANELUSER_almesbah
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- SMTP (من العميل — الرسائل بتتحفظ في الداشبورد حتى لو الإيميل واقع) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.almesbah-eg.com
MAIL_PORT=465
MAIL_USERNAME=info@almesbah-eg.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@almesbah-eg.com
MAIL_FROM_NAME="ALMESBAH"
